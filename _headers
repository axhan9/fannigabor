# Netlify / Cloudflare Pages: biztonsági és "nem indexelhető" fejlécek.
# (GitHub Pages ezt a fájlt figyelmen kívül hagyja – ott a HTML-ben lévő meta robots tag véd.)
# A CSP-ben a fonts.googleapis.com / fonts.gstatic.com részeket töröld, ha saját tárolású betűtípusra váltasz.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.make.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
